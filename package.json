{
  "name": "mac-streamdeck",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Read-only Mac sensor readings on Stream Deck.",
  "author": "Stephen Lawrensen",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "core:sync": "node scripts/core/sync.mjs sync",
    "core:check": "node scripts/core/sync.mjs check",
    "core:patch": "node scripts/core/sync.mjs patch",
    "lint": "eslint src scripts test --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/core/test.mjs",
    "test:mac": "tsx --tsconfig tsconfig.mac.json --test --test-concurrency=1 test/mac/*.test.ts test/mac/pi-sim.test.mjs",
    "build": "node scripts/sync-identity.mjs && node scripts/stage-native.mjs && rollup -c && node scripts/stage-panels.mjs && node scripts/assemble.mjs",
    "test:core-sync": "node --test test/mac/core-sync.test.mjs",
    "core:parity": "node scripts/core/parity.mjs",
    "stage:panels": "node scripts/stage-panels.mjs",
    "build:native": "node scripts/build-native.mjs",
    "test:native": "node --expose-gc --test --test-concurrency=1 test/mac/native.test.mjs test/mac/native-package.test.mjs",
    "probe": "tsx --tsconfig tsconfig.mac.json scripts/probe.ts",
    "native:repro": "node scripts/native-repro.mjs",
    "native:manifest": "node scripts/native-manifest.mjs",
    "native:validate": "node scripts/validate-native.mjs",
    "abi": "node scripts/abi-check.mjs",
    "profiles:detail": "tsx scripts/build-detail-profiles.ts",
    "pack": "node scripts/pack.mjs",
    "pack:validate": "node scripts/validate-pack.mjs",
    "release:validate": "node scripts/qualify.mjs",
    "copy:validate": "node scripts/validate-release-copy.mjs",
    "build:test": "node scripts/build-test-plugin.mjs",
    "e2e": "node scripts/e2e.mjs core",
    "e2e:resilience": "node scripts/e2e.mjs resilience",
    "e2e:native-edge": "node scripts/e2e.mjs native-edge",
    "e2e:drilldown": "node scripts/e2e.mjs drilldown",
    "e2e:socket-close": "node scripts/e2e.mjs socket-close",
    "e2e:pi-panels": "tsx --tsconfig tsconfig.mac.json scripts/e2e-pi-panels.mjs",
    "build:dev": "node scripts/dev-clone.mjs",
    "suite:full": "node scripts/suite.mjs",
    "e2e:pi": "node scripts/e2e-pi-persistence.mjs",
    "e2e:load": "node scripts/e2e.mjs load",
    "pi:lab": "tsx --tsconfig tsconfig.mac.json scripts/pi-lab.mjs",
    "build:observer": "node scripts/build-observer.mjs",
    "test:soak": "node --test test/mac/soak.test.mjs",
    "soak": "node scripts/soak-monitor.mjs",
    "docs:assets": "tsx --tsconfig tsconfig.mac.json scripts/docs-assets.mjs",
    "capture:panels": "tsx --tsconfig tsconfig.mac.json scripts/capture-mac-panels.mjs",
    "readme-boards": "node scripts/readme-boards.mjs",
    "marketing:shots": "node scripts/marketplace-shots.mjs",
    "changelog:page": "node scripts/gen-changelog-page.mjs",
    "docs:validate": "node scripts/validate-docs.mjs",
    "docs:crawl": "node scripts/docs-crawl.mjs",
    "docs:shots": "node scripts/docs-site-shots.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2",
    "@elgato/utils": "^0.6.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.7.4",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "24.19.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "koffi": "^3.1.0",
    "node-gyp": "^12.4.0",
    "rollup": "^4.63.3",
    "sharp": "^0.35.4",
    "tslib": "^2.8.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "ws": "^8.21.3"
  }
}

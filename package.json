{
  "name": "mac-streamdeck",
  "version": "0.9.90",
  "private": true,
  "type": "module",
  "description": "Read-only Mac sensor readings on Stream Deck.",
  "author": "Stephen Lawrensen",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "core:sync": "node scripts/core/sync.mjs sync",
    "core:check": "node scripts/core/sync.mjs check",
    "core:patch": "node scripts/core/sync.mjs patch",
    "lint": "eslint src scripts test --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/core/test.mjs",
    "test:mac": "tsx --tsconfig tsconfig.mac.json --test --test-concurrency=1 test/mac/*.test.ts",
    "build": "rollup -c",
    "test:core-sync": "node --test test/mac/core-sync.test.mjs",
    "core:parity": "node scripts/core/parity.mjs",
    "stage:panels": "node scripts/stage-panels.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2",
    "@elgato/utils": "^0.6.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.7.4",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "24.19.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "koffi": "^3.1.0",
    "node-gyp": "^12.4.0",
    "rollup": "^4.63.3",
    "sharp": "^0.35.4",
    "tslib": "^2.8.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "ws": "^8.21.3"
  }
}
